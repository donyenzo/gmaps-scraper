# ─── WAJIB: Auth token untuk proteksi endpoint ────────────────────────────────
# Generate token: openssl rand -hex 32
# Paste nilai yang sama ke Vercel env vars DAN ke UI browser kamu
SCRAPER_AUTH_TOKEN=ganti_dengan_token_acak_yang_panjang

# ─── Opsional: Preset Serper API keys di server ───────────────────────────────
# Comma-separated. Hanya bisa diakses setelah auth token valid.
SERPER_API_KEYS=513fe2e3414aadcccb47ba927db98a9401cb34e9,a9c180d0b44b6769df65ce92485a692b3d3ba58e,b007133884f28c5d0a959be933f8a40eb0d5c0fc,343a795b37b49ceb340556fad0e0e8055b2df2fb,c637c284a3d57398795e16b67e5a85267aa8129a,9289d97f9aa451838438efcecb98dc7720f626e5,8026cf9fdb749b2c44164cc676a33b0e5e0e2d73

# ─── Opsional: Batasi CORS ke domain Vercel kamu ─────────────────────────────
# Contoh: https://gmaps-scraper-mu.vercel.app
# Jika dikosongkan → pakai wildcard (*) — cocok untuk dev lokal
ALLOWED_ORIGIN=https://nama-project-kamu.vercel.app
